Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^miraiz-tsukaguchi-website-deploy-xserver-miraiz(?:/|\.zip$) - [F,L]
RewriteCond %{HTTP_HOST} ^miraiz\.sofi-school\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://miraiz.sofi-school.com%{REQUEST_URI} [R=301,L]
</IfModule>
<Files "xserver-default-backup.html">
Require all denied
</Files>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
