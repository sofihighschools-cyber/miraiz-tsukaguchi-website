Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 常に正式なHTTPSドメインへ統一
RewriteCond %{HTTP_HOST} !^miraiz\.sofi-school\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://miraiz.sofi-school.com%{REQUEST_URI} [R=301,L]

# Vercelと同じ /news のURLで静的HTMLを配信
RewriteRule ^news/?$ news.html [L]

# アップロード用アーカイブやバックアップを公開しない
RewriteRule ^miraiz-tsukaguchi-website-deploy-xserver-miraiz(?:/|\.zip$) - [F,L]
</IfModule>

<FilesMatch "^(?:xserver-default-backup\.html|.*\.(?:bak|old|orig))$">
Require all denied
</FilesMatch>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
